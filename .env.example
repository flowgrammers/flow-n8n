# flow-n8n-harness — copie para .env e preencha. O .env não é versionado.
#
# Nenhuma instância vem embutida no código, de propósito: esteira com instância
# padrão cria workflow de teste no lugar errado, e o estrago aparece depois.

# URL base da instância, SEM /api/v1. Ex.: https://n8n.suaempresa.com.br
N8N_API_URL=

# Chave da API. Sai em: n8n → Settings → n8n API → Create an API key.
# Escopo mínimo: workflow e execution.
N8N_API_KEY=

# Só se o editor estiver em outro host que a API. Vazio = usa N8N_API_URL.
N8N_UI_URL=
